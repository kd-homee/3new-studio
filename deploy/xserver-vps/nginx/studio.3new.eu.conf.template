# =====================================================================
# TEMPLATE ONLY — NOT DEPLOYED. 3NEW Studio vhost for studio.3new.eu
# =====================================================================
# Every __PLACEHOLDER__ must be replaced with a value CONFIRMED on the VPS
# during the read-only preflight (see ../HANDOFF.md). Do not guess.
#
#   __STUDIO_HOST_PORT__         localhost port published by docker-compose.yml (STUDIO_HOST_PORT)
#   __ACME_WEBROOT__             certbot webroot, if HTTP-01 webroot is the method in use
#   __SSL_CERT_FULLCHAIN_PATH__  e.g. a Let's Encrypt fullchain.pem for studio.3new.eu
#   __SSL_CERT_KEY_PATH__        matching privkey.pem
#   __LOG_DIR__                  Nginx log directory (dedicated files for this vhost)
#
# Assumptions to verify on the VPS:
#   - Nginx runs on the host (not in a container) and includes per-site files.
#   - Nginx >= 1.25.1 for "http2 on;" (otherwise use "listen 443 ssl http2;").
#   - IPv6 listeners are valid on this host (remove [::] lines if not).
#   - No http{}-level map/upstream is added here, to avoid name collisions with other vhosts.
#
# HTTP -> HTTPS: port 80 only serves ACME challenges and redirects everything else to HTTPS.
# The first certificate must be issued BEFORE enabling the 443 server block (or use a staging
# hostname first); see HANDOFF.md.
# =====================================================================

server {
    listen 80;
    listen [::]:80;
    server_name studio.3new.eu;

    location ^~ /.well-known/acme-challenge/ {
        root __ACME_WEBROOT__;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name studio.3new.eu;

    ssl_certificate     __SSL_CERT_FULLCHAIN_PATH__;
    ssl_certificate_key __SSL_CERT_KEY_PATH__;

    # Same HSTS policy Vercel currently sends for this hostname.
    add_header Strict-Transport-Security "max-age=63072000" always;

    access_log __LOG_DIR__/studio.3new.eu.access.log;
    error_log  __LOG_DIR__/studio.3new.eu.error.log warn;

    # Transcription uploads 10-minute WAV chunks (~19.2 MB each) to /api/transcribe.
    client_max_body_size 25m;

    location / {
        proxy_pass http://127.0.0.1:__STUDIO_HOST_PORT__;
        proxy_http_version 1.1;

        # Host / scheme must reach Next.js intact: /auth/callback builds redirects from the request origin.
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        # Upgrade passthrough without an http{}-level map (not needed in production, harmless).
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $http_connection;

        # Defense in depth: never let clients supply Next.js internal proxy-bypass headers.
        proxy_set_header x-middleware-subrequest "";

        proxy_connect_timeout 10s;
        proxy_send_timeout    300s;
        proxy_read_timeout    300s;
    }
}
