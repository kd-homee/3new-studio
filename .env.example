# 3NEW Studio environment variables — NAMES ONLY. Never commit real values.
# Local dev: copy to .env.local. VPS (docker compose): copy to .env in the app directory.
# Each value must be specific to 3NEW Studio; do not reuse keys from other projects.

# --- Supabase Auth (Phase 1 keeps the existing Supabase project; Auth only, no DB/Storage) ---
# Also passed as Docker build args: inlined into the browser bundle at build time.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Not referenced by application code; do not set on the VPS unless a future feature needs it.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Access control ---
# Comma-separated allowlist. REQUIRED: if empty, every signed-in Supabase user is admitted.
ALLOWED_EMAILS=

# --- External APIs (server-side only) ---
# Anthropic Claude API (/api/minutes). Record new keys in the Notion API Key ledger:
# https://www.notion.so/36d09405541d8147ad85c434e3c1686c
ANTHROPIC_API_KEY=
# OpenAI Whisper API (/api/transcribe)
OPENAI_API_KEY=
# Notion integration and target database ID (/api/notion)
NOTION_API_KEY=
NOTION_DATABASE_ID=

# --- VPS container (docker compose only) ---
# Free localhost port on the VPS that Nginx proxies to. Confirm during VPS preflight.
STUDIO_HOST_PORT=
